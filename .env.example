# GEMINI_API_KEY: Injected by AI Studio if needed
GEMINI_API_KEY=""

# APP_URL / SITE_URL
APP_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
SITE_NAME="THE VOID REGISTRY"

# Supabase (Server Only - RLS enabled without public policies)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Security & Hashing (Server Only - >= 32 byte random secret)
HASH_SECRET="change-this-to-a-secure-32-byte-secret-key-hmac"

# Upstash Redis (Rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Admin Allowlist (comma-separated emails)
ADMIN_EMAILS="admin@thevoidregistry.com"

# Feature Flags
FEATURE_CONFESSION="false"
FEATURE_PAYMENTS="false"

# Payments (Midtrans or Xendit)
PAYMENT_PROVIDER="midtrans"
PAYMENT_SERVER_KEY=""
PAYMENT_WEBHOOK_SECRET=""
